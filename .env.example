# Configure these variables only on the PHP server. Never commit real API keys
# or private recipient addresses to GitHub and never expose them in JavaScript.
APPLICATION_ENV=production
APPLICATION_RECIPIENTS=recipient@example.com
RESEND_API_KEY=replace_with_secret
RESEND_FROM_EMAIL=G10 Kirov <forms@verified-sending-domain.example>
APPLICATION_ALLOWED_ORIGINS=https://g10.kirov.restoved.ru,https://www.g10.kirov.restoved.ru

