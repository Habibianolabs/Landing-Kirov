# Production form delivery on the IHC server uses PHP mail() and does not
# require an API key or a cloud database token. The sender and recipients are
# kept in api/submit-application.php so they never enter frontend JavaScript.
MAIL_FROM_EMAIL=event@restoranoff.ru
APPLICATION_RECIPIENTS=lp@restoranoff.ru,rv@restoranoff.ru,event@restoranoff.ru,p.spiridonova@restoranoff.ru

# The legacy api/submit-application.js adapter for the demo host has its own
# provider contract; never put real secrets in this example or in Git.
