# Resend: API key and a sender address verified in Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="G10 Киров <forms@example.com>"

# Optional comma-separated override; defaults to the four addresses from the brief
APPLICATION_RECIPIENTS=lp@restoranoff.ru,rv@restoranoff.ru,event@restoranoff.ru,p.spiridonova@restoranoff.ru

# Upstash Redis REST credentials for production rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional: enables Cloudflare Turnstile verification when configured
TURNSTILE_SECRET_KEY=
